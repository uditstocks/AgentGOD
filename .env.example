# Copy this file to .env and fill in your real key.
# .env is gitignored - never commit it.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model (claude-sonnet-5)
# MODEL=claude-sonnet-5

# Optional tuning (defaults shown)
# MAX_AGENTS=4
# AGENT_TIMEOUT_SECONDS=300
# AGENT_REPAIR_ATTEMPTS=2
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_TOKENS=8192

# How hard the model works per call: low | medium | high | xhigh | max.
# There is no temperature setting; this is the knob that replaced it.
# LLM_EFFORT=medium

# How many independent agents may run at the same time. Parallelism only ever
# happens between agents the plan's dependency graph proves independent, so
# this is a ceiling, not a correctness knob. 1 disables it.
# MAX_PARALLEL_AGENTS=4

# The council: an adversarial critic that cross-examines the merged answer
# before the judge sees it. auto = only for tasks graded deep.
# COUNCIL=auto        # auto | always | off

# Standing answer to the keep-or-discard question after a run builds new
# agents: always | never. Unset = ask (interactive) / keep (scripts).
# AGENTGOD_KEEP=always

# The one pre-run clarifying question: auto | off.
# CLARIFY=auto

# Which model does which job. FAST_MODEL runs the mechanical checks (the
# clarifying question, the answer's compliance check); DEEP_MODEL is used only
# for tasks the planner grades 'deep' and defaults to MODEL, so setting it is
# how you spend more on hard work without spending more on easy work.
# FAST_MODEL=claude-haiku-4-5
# DEEP_MODEL=claude-opus-5

# Searches one agent call may run. Each search carries a per-use fee of its
# own - one search bills more than an entire simple task - so this is the most
# expensive dial in the product.
# WEB_SEARCH_MAX_USES=3
