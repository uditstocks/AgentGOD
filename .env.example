# Copy this file to .env and fill in your real key.
# .env is gitignored - never commit it.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model (claude-sonnet-5)
# MODEL=claude-sonnet-5

# Optional tuning (defaults shown)
# MAX_AGENTS=4
# AGENT_TIMEOUT_SECONDS=300
# AGENT_REPAIR_ATTEMPTS=2
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_TOKENS=8192

# How hard the model works per call: low | medium | high | xhigh | max.
# There is no temperature setting; this is the knob that replaced it.
# LLM_EFFORT=medium
